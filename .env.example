POSTGRES_DB=serverwatch
POSTGRES_USER=serverwatch
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
SERVERWATCH_HTTP_ADDR=127.0.0.1:8080
SERVERWATCH_HTTP_PORT=8080
