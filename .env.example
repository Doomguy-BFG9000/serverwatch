POSTGRES_DB=serverwatch
POSTGRES_USER=serverwatch
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
SERVERWATCH_HTTP_ADDR=127.0.0.1:8080
SERVERWATCH_HTTP_PORT=8080
DATABASE_URL=postgres://serverwatch:change-me@127.0.0.1:5432/serverwatch?sslmode=disable

# Optional API access token. When set to a non-empty value, every /api/v1/...
# request must send "Authorization: Bearer <token>". Leave empty to keep the
# API open (default). Health endpoints /health and /ready are always open.
# Generate a strong value, for example: openssl rand -hex 32
SERVERWATCH_API_TOKEN=

# Optional account authentication. When SERVERWATCH_AUTH_ENABLED=true the
# dashboard requires a login and all /api/v1/... routes (except the auth
# endpoints and health probes) require a valid session cookie. The first
# visitor creates the administrator account. Off by default.
SERVERWATCH_AUTH_ENABLED=false
# Session lifetime, as a Go duration (default 720h = 30 days).
SERVERWATCH_SESSION_TTL=720h
# Set true only when the dashboard is served over HTTPS so the session cookie
# carries the Secure attribute.
SERVERWATCH_COOKIE_SECURE=false

# --- Security & operations (Phase 0.50) ---

# Expose a Prometheus text-format /metrics endpoint. Off by default. When
# enabled, keep it off the public internet (see deployments/nginx/serverwatch.conf).
SERVERWATCH_METRICS_ENABLED=false

# Per-client API rate limit (token bucket). Applies to /api/ only. Set the rate
# to 0 to disable. Defaults to 10 requests/second with a burst of 30.
SERVERWATCH_RATE_LIMIT_RPS=10
SERVERWATCH_RATE_LIMIT_BURST=30

# Trust X-Forwarded-For / X-Real-IP from a reverse proxy when identifying
# clients (correct when running behind the documented Nginx setup). Set false
# if the backend is exposed directly.
SERVERWATCH_TRUST_PROXY=true

# --- Data retention (Phase 0.51) ---

# Days of check history (monitor_results) to keep. A daily job deletes older
# rows while always preserving the most recent result for every monitor. Set to
# 0 to keep history forever (the table then grows without bound). Default 30.
SERVERWATCH_RESULT_RETENTION_DAYS=30

# Optional plain-text email alerts. Never commit SMTP_PASSWORD.
SERVERWATCH_ALERT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Optional Telegram alerts (Phase 0.52). Create a bot with @BotFather, then put
# the token and the destination chat id here. TELEGRAM_API_BASE is only needed
# for a self-hosted Bot API server; leave empty for the public API. Never commit
# TELEGRAM_BOT_TOKEN.
SERVERWATCH_ALERT_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=
