POSTGRES_DB=serverwatch
POSTGRES_USER=serverwatch
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
SERVERWATCH_HTTP_ADDR=127.0.0.1:8080
SERVERWATCH_HTTP_PORT=8080
DATABASE_URL=postgres://serverwatch:change-me@127.0.0.1:5432/serverwatch?sslmode=disable

# Optional API access token. When set to a non-empty value, every /api/v1/...
# request must send "Authorization: Bearer <token>". Leave empty to keep the
# API open (default). Health endpoints /health and /ready are always open.
# Generate a strong value, for example: openssl rand -hex 32
SERVERWATCH_API_TOKEN=

# Optional plain-text email alerts. Never commit SMTP_PASSWORD.
SERVERWATCH_ALERT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_TLS=true
